# ---- Supabase (required) ----
# Local values are printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random secret (>= 32 chars) for keyed hashing of phone numbers / beneficiary ids.
# Generate: openssl rand -hex 32
ATHAR_HMAC_SECRET=

# ---- AI (optional: without it the pipeline runs in labelled rule-based mode) ----
ANTHROPIC_API_KEY=
ATHAR_AI_MODEL=claude-opus-5-5
# Embeddings for recycled-post detection (optional; trigram similarity is used otherwise)
VOYAGE_API_KEY=

# ---- Abuse protection (optional in dev, required in production) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Intake channels (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- SMS (console = log only, nothing is sent) ----
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_SECRET=

# Shared secret for scheduled jobs calling /api/cron/*
CRON_SECRET=
